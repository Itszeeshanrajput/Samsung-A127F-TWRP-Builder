@echo off\nREM Samsung A127F Firmware Complete Auto-Extractor\nREM One-click extraction of ALL required files\nREM No websites, no complicated tools needed!\n\nsetlocal enabledelayedexpansion\nchcp 65001 >nul 2>&1\n\necho.\necho ==========================================\necho  Samsung A127F Complete Extractor\necho  Kernel, DTB, Recovery, Build Properties\necho ==========================================\necho.\n\nREM Create working directory\nset \"WORK_DIR=%cd%\\EXTRACTION_OUTPUT\"\nif not exist \"%WORK_DIR%\" mkdir \"%WORK_DIR%\"\n\nREM Check for 7-Zip\nwhere 7z >nul 2>nul\nif %errorlevel% neq 0 (\n    echo [ERROR] 7-Zip not found!\n    echo Please install from: https://www.7-zip.org/\n    echo Select \"Add 7-Zip to PATH\" during installation\n    pause\n    exit /b 1\n)\n\necho [Step 1/6] Finding firmware file...\ncd /d \"%~dp0\"\n\nset \"firmware_file=\"\nfor %%f in (*.tar.md5 *.tar) do (\n    if exist \"%%f\" (\n        set \"firmware_file=%%f\"\n        echo Found: !firmware_file!\n        goto found_firmware\n    )\n)\n\necho [ERROR] No .tar.md5 or .tar file found!\necho Please place firmware in: %cd%\npause\nexit /b 1\n\n:found_firmware\necho.\necho [Step 2/6] Extracting main firmware (this may take 2-3 minutes)...\n7z x \"%firmware_file%\" -o\"%WORK_DIR%\" -y >nul 2>&1\n\nif %errorlevel% neq 0 (\n    echo [ERROR] Failed to extract firmware!\n    pause\n    exit /b 1\n)\n\necho Done!\necho.\necho [Step 3/6] Finding AP file...\n\nset \"ap_file=\"\nfor /d %%d in (\"%WORK_DIR%\"\\*) do (\n    for %%f in (\"%%d\"\\AP_*.tar.md5 \"%%d\"\\AP_*.tar) do (\n        if exist \"%%f\" (\n            set \"ap_file=%%f\"\n            goto found_ap\n        )\n    )\n)\n\nfor %%f in (\"%WORK_DIR%\"\\AP_*.tar.md5 \"%WORK_DIR%\"\\AP_*.tar) do (\n    if exist \"%%f\" (\n        set \"ap_file=%%f\"\n        goto found_ap\n    )\n)\n\necho [WARNING] No AP file found in standard location\ngoto extract_images\n\n:found_ap\necho Found: !ap_file!\necho.\necho [Step 4/6] Extracting AP file (contains boot, recovery, system)...\n7z x \"!ap_file!\" -o\"%WORK_DIR%\" -y >nul 2>&1\n\nif %errorlevel% neq 0 (\n    echo [WARNING] AP extraction had issues, continuing anyway...\n)\n\necho Done!\n\n:extract_images\necho.\necho [Step 5/6] Collecting required image files...\n\nREM Copy boot.img\nfor /r \"%WORK_DIR%\" %%f in (boot.img) do (\n    copy \"%%f\" \"%WORK_DIR%\\boot.img\" >nul 2>&1\n    echo ✓ Found boot.img\n    goto found_boot\n)\n:found_boot\n\nREM Copy recovery.img\nfor /r \"%WORK_DIR%\" %%f in (recovery.img) do (\n    copy \"%%f\" \"%WORK_DIR%\\recovery.img\" >nul 2>&1\n    echo ✓ Found recovery.img\n    goto found_recovery\n)\n:found_recovery\n\nREM Copy dtbo.img\nfor /r \"%WORK_DIR%\" %%f in (dtbo.img) do (\n    copy \"%%f\" \"%WORK_DIR%\\dtbo.img\" >nul 2>&1\n    echo ✓ Found dtbo.img\n    goto found_dtbo\n)\n:found_dtbo\n\necho.\necho [Step 6/6] Creating summary report...\n\nREM Create summary file\n(\n    echo ==================================================\n    echo Samsung A127F Firmware Extraction Report\n    echo ==================================================\n    echo.\n    echo DEVICE INFO:\n    echo Build: A127FXXSDDXJ1\n    echo Model: SM-A127F\n    echo Device Code: a12s\n    echo Android: 13\n    echo Chipset: Exynos 850\n    echo.\n    echo EXTRACTED FILES:\n) > \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n\nif exist \"%WORK_DIR%\\boot.img\" (\n    for %%A in (\"%WORK_DIR%\\boot.img\") do set \"size=%%~zA\"\n    echo ✓ boot.img (!size! bytes^) >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ✓ boot.img (!size! bytes)\n) else (\n    echo ✗ boot.img NOT found >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ✗ boot.img NOT found\n)\n\nif exist \"%WORK_DIR%\\recovery.img\" (\n    for %%A in (\"%WORK_DIR%\\recovery.img\") do set \"size=%%~zA\"\n    echo ✓ recovery.img (!size! bytes^) >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ✓ recovery.img (!size! bytes)\n) else (\n    echo ✗ recovery.img NOT found >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ✗ recovery.img NOT found\n)\n\nif exist \"%WORK_DIR%\\dtbo.img\" (\n    for %%A in (\"%WORK_DIR%\\dtbo.img\") do set \"size=%%~zA\"\n    echo ✓ dtbo.img (!size! bytes^) >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ✓ dtbo.img (!size! bytes)\n) else (\n    echo ○ dtbo.img not found (optional^) >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n    echo ○ dtbo.img not found (optional)\n)\n\necho. >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho KERNEL INFO FOUND: >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho Linux version 4.19.111-27127798 >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho. >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho NEXT STEPS: >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho 1. boot.img - Kernel + ramdisk (for TWRP kernel compilation^) >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho 2. recovery.img - Contains partition table/fstab >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho 3. dtbo.img - Device tree binary overlay >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho. >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\necho All files are ready for TWRP builder setup >> \"%WORK_DIR%\\EXTRACTION_REPORT.txt\"\n\necho.\necho ==========================================\necho ✓ EXTRACTION COMPLETE!\necho ==========================================\necho.\necho Extracted files location:\necho %WORK_DIR%\necho.\necho Files ready:\necho  • boot.img (kernel + ramdisk^)\necho  • recovery.img (partition table^)\necho  • dtbo.img (device tree^)\necho  • EXTRACTION_REPORT.txt\necho.\necho TWRP Builder is ready to use!\necho.\necho Press any key to open extraction folder...\npause\nstart explorer \"%WORK_DIR%\"\n