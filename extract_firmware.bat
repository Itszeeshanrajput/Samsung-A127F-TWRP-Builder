@echo off\nREM Samsung A127F Firmware Auto-Extractor\nREM One-click solution for Windows\nREM No websites needed!\n\nsetlocal enabledelayedexpansion\n\necho.\necho ============================================\necho Samsung A127F Firmware Extractor\necho ============================================\necho.\n\nREM Check if 7z.exe is available\nwhere 7z >nul 2>nul\nif %errorlevel% neq 0 (\n    echo ERROR: 7-Zip not found!\n    echo Please install 7-Zip from: https://www.7-zip.org/\n    echo And select \"Add 7-Zip to PATH\" during installation\n    pause\n    exit /b 1\n)\n\necho [1/5] Looking for firmware file...\ncd /d \"%~dp0\"\n\nREM Find firmware file\nset \"firmware_file=\"\nfor %%f in (*.tar.md5 *.tar) do (\n    if exist \"%%f\" (\n        set \"firmware_file=%%f\"\n        echo Found: !firmware_file!\n        goto found_firmware\n    )\n)\n\necho ERROR: No .tar.md5 or .tar file found in this directory!\necho Please place your firmware file here: %cd%\npause\nexit /b 1\n\n:found_firmware\necho.\necho [2/5] Extracting main firmware...\n7z x \"%firmware_file%\" -o\"%cd%\" -y >nul 2>&1\n\nif %errorlevel% neq 0 (\n    echo ERROR: Failed to extract firmware!\n    pause\n    exit /b 1\n)\n\necho Done!\necho.\necho [3/5] Looking for AP file...\n\nset \"ap_file=\"\nfor %%f in (AP_*.tar.md5 AP_*.tar) do (\n    if exist \"%%f\" (\n        set \"ap_file=%%f\"\n        echo Found: !ap_file!\n        goto found_ap\n    )\n)\n\necho WARNING: No AP file found. Checking for alternative...\nfor %%f in (*.tar.md5 *.tar) do (\n    if \"%%f\" neq \"%firmware_file%\" (\n        set \"ap_file=%%f\"\n        echo Using: !ap_file!\n        goto found_ap\n    )\n)\n\necho ERROR: Cannot find AP file!\npause\nexit /b 1\n\n:found_ap\necho.\necho [4/5] Extracting AP file (this may take 2-3 minutes)...\n7z x \"!ap_file!\" -o\"%cd%\\AP_EXTRACTED\" -y >nul 2>&1\n\nif %errorlevel% neq 0 (\n    echo WARNING: AP extraction had issues, but continuing...\n)\n\necho Done!\necho.\necho [5/5] Copying boot.img and recovery.img...\n\nif exist \"AP_EXTRACTED\\boot.img\" (\n    copy \"AP_EXTRACTED\\boot.img\" \"boot.img\" >nul 2>&1\n    echo ✓ boot.img copied\n) else (\n    if exist \"boot.img\" (\n        echo ✓ boot.img already present\n    ) else (\n        echo WARNING: boot.img not found\n    )\n)\n\nif exist \"AP_EXTRACTED\\recovery.img\" (\n    copy \"AP_EXTRACTED\\recovery.img\" \"recovery.img\" >nul 2>&1\n    echo ✓ recovery.img copied\n) else (\n    if exist \"recovery.img\" (\n        echo ✓ recovery.img already present\n    ) else (\n        echo WARNING: recovery.img not found\n    )\n)\n\nif exist \"AP_EXTRACTED\\dtbo.img\" (\n    copy \"AP_EXTRACTED\\dtbo.img\" \"dtbo.img\" >nul 2>&1\n    echo ✓ dtbo.img copied\n) else (\n    echo ✓ dtbo.img not found (may not be needed)\n)\n\necho.\necho ============================================\necho EXTRACTION COMPLETE!\necho ============================================\necho.\necho The following files are now ready:\n\nif exist \"boot.img\" (\n    for %%A in (\"boot.img\") do set \"size=%%~zA\"\n    echo  ✓ boot.img (!size! bytes)\n)\n\nif exist \"recovery.img\" (\n    for %%A in (\"recovery.img\") do set \"size=%%~zA\"\n    echo  ✓ recovery.img (!size! bytes)\n)\n\nif exist \"dtbo.img\" (\n    for %%A in (\"dtbo.img\") do set \"size=%%~zA\"\n    echo  ✓ dtbo.img (!size! bytes)\n)\n\necho.\necho Location: %cd%\necho.\necho Next steps:\necho 1. Open boot.img with HxD (https://mh-nexus.de/en/hxd/)\necho 2. Press Ctrl+F and search for \"Linux version\"\necho 3. Note the kernel version\necho 4. Run: extract_recovery_fstab.bat\necho.\npause\n